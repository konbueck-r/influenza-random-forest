# Raw input data stays out of git; data/README.md documents it and CHECKSUMS.txt pins it.
data/*
!data/README.md
!data/CHECKSUMS.txt
!data/example_counts.csv
!data/example_sample_table.csv

# Course material and papers: copyrighted or personal, kept locally only.
docs/*.pdf
docs/*.docx
docs/*.pptx

# Generated by the pipeline, reproducible from data/ and scripts/.
results/
figures/

# R session artifacts and a possible project library.
.Rhistory
.RData
Rplots.pdf
renv/library/

# Rendered report and the generated pandoc default template; rebuilt from report/report.qmd.
report/*_report.docx
report/reference_default.docx
report/*_files/

# Personal title-page details (matriculation number, supervisors) and the public report build.
report/private_details.txt
report/*_public.docx

# Website build output and copied assets; rebuilt by quarto render / make_report_pdf.ps1.
website/_site/
website/assets/
website/.quarto/
website/*_files/
